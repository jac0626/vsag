        "dim": 128,
        "dtype": "float32",
        "metric_type": "l2",
        "index_param": {
          "base_quantization_type": [
            "fp32",
            "sq8_uniform"
          ],
          "max_degree": [
            16,
            32
          ],
          "ef_construction": 100
        }
      },
      "search_params": {
        "hgraph": {
          "ef_search": [
            40,
            80,
            120
          ]
        }
      }
    },
    {
      "name": "ivf",
      "create_params": {
        "dim": 128,
        "dtype": "float32",
        "metric_type": "l2",
        "index_param": {
